{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "transient_prompt": {
    "enabled": true,
    "foreground": "#EBDBB2",
    "template": "───> "
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#EBDBB2",
          "template": "╭─["
        },
        {
          "type": "os",
          "style": "plain",
          "foreground": "#458588",
          "template": "{{.Icon}} "
        },
        {
          "foreground": "#458588",
          "style": "plain",
          "template": "{{ .Name }}",
          "type": "shell"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#EBDBB2",
          "template": "]-["
        },
        {
          "type": "session",
          "style": "plain",
          "foreground": "#b16286",
          "template": "{{ if .SSHSession }}<#cc241d> {{ end }}{{.UserName}}@{{.HostName}}{{ if .SSHSession }}</>{{ end }}"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#EBDBB2",
          "template": "]-["
        },
        {
          "type": "path",
          "style": "plain",
          "template": "{{ .Path }}",
          "options": {
            "style": "agnoster_short",
            "max_depth": 5
          },
          "foreground": "#d65d0e"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#EBDBB2",
          "template": "]"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "type": "node",
          "style": "plain",
          "foreground": "#669A68",
          "template": "<#EBDBB2>(</> {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }}<#EBDBB2>)</>"
        },
        {
          "type": "angular",
          "style": "plain",
          "foreground": "#cc241d",
          "template": "<#EBDBB2>(</> {{ .Full }}<#EBDBB2>)</>"
        },
        {
          "type": "react",
          "style": "plain",
          "foreground": "#7cb0e4",
          "template": "<#EBDBB2>(</> {{ .Full }}<#EBDBB2>)</>"
        },
        {
          "type": "tauri",
          "style": "plain",
          "foreground": "#24c8db",
          "template": "<#EBDBB2>(</> {{ .Full }}<#EBDBB2>)</>"
        },
        {
          "type": "svelte",
          "style": "plain",
          "foreground": "#ff3e00",
          "template": "<#dddddd>(</> {{ .Full }}<#dddddd>)</>"
        },
        {
          "type": "rust",
          "style": "plain",
          "foreground": "#8f1c1c",
          "template": "<#dddddd>(</> {{ .Full }}<#dddddd>)</>"
        },
        {
          "foreground": "#0d6da8",
          "style": "plain",
          "template": "<#EBDBB2>(</> {{ if .Unsupported }} {{ else }}{{ .Full }}{{ end }}<#EBDBB2>)</>",
          "type": "dotnet"
        },
        {
          "type": "text",
          "style": "plain",
          "foreground": "#EBDBB2",
          "template": "  "
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "style": "plain",
          "template": "╰─",
          "type": "text",
          "foreground": "#EBDBB2"
        },
        {
          "foreground": "#d79921",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#ffeb95{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#c5e478{{ end }}",
            "{{ if gt .Ahead 0 }}#C792EA{{ end }}",
            "{{ if gt .Behind 0 }}#C792EA{{ end }}"
          ],
          "options": {
            "branch_icon": "\ue725 ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "plain",
          "template": "<#EBDBB2>[</>{{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044 {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}<#ef5350> \uf046 {{ .Staging.String }}</>{{ end }}<#EBDBB2>]</>",
          "type": "git"
        },
        {
          "foreground": "#cc241d",
          "style": "plain",
          "template": "ROOT",
          "type": "root"
        },
        {
          "foreground": "#EBDBB2",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#ef5350{{ end }}"
          ],
          "style": "plain",
          "template": "> ",
          "type": "text",
          "options": {
            "always_enabled": true
          }
        }
      ],
      "type": "prompt"
    }
  ],
  "tooltips": [
    {
      "type": "az",
      "tips": [
        "azure",
        "terraform",
        "az"
      ],
      "style": "plain",
      "foreground": "#9ec3f0",
      "template": "  <#dddddd>[</> {{.Name}}<#dddddd>]</>"
    },
    {
      "type": "aws",
      "tips": [
        "aws",
        "terraform"
      ],
      "style": "plain",
      "foreground": "#faa029",
      "template": "<#dddddd>[</> {{.Profile}}{{if .Region}}@{{.Region}}{{end}}<#dddddd>]</>"
    }
  ],
  "version": 3
}